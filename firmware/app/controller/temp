/**
 * @brief  Starts the specified servo channel.
 *
 * @param  servo Servo channel to enable.
 */
void Ctrlr_ServoStart(CTRLR_SERVOS_T servo) {
    PLT_ASSERT(CTRLR_NUM_SERVOS > servo);
    Servo_Start((SERVO_HANDLER_T)&Target_Servos[servo]);
}

/**
 * @brief  Set angle target for a servo channel.
 *
 * @param  servo Servo channel to be configured.
 * @param  travel Angle set point for the servo channel. See note 1.
 *
 * @note List of notes:
 *       1. The angle will be saturated between -90 and 90 deg.
 */
void Ctrlr_ServoSet(CTRLR_SERVOS_T servo, float32_t travel) {
    PLT_ASSERT(CTRLR_NUM_SERVOS > servo);
    Servo_SetSpan((SERVO_HANDLER_T)&Target_Servos[servo], travel);
}

