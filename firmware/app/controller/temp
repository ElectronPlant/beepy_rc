/**
 * @brief  
 *
 * @param  inp 
 *
 * @return DEF_TRUE if successful, DEF_FALSE otherwise.
 *
 * @note List of notes:
 *       1. 
 */
static void Ctrlr_InitTranslator(void) {
    /* Set all channels as disabled */
    for (uint16_t chn = 0; chn < STD_FRAME_NUM_CHANNELS; chn++) {
        ChannelTranslator[chn].Type = CRTLR_DISABLED;
    }

    /* Set the default configuration */
    ChannelTranslator[CTRLR_DEFAULT_THROTTLE_CHN].Type = CRTLR_TYPE_THROTTLE;
    ChannelTranslator[CTRLR_DEFAULT_THROTTLE_CHN].Curve.Type = CTRLR_CURVE_TYPE_NONE;
    ChannelTranslator[CTRLR_DEFAULT_THROTTLE_CHN].ActionFunc = Ctrlr_ThrottleSet;

    ChannelTranslator[CTRLR_DEFAULT_VANG_CHN].Type = CRTLR_TYPE_VANG;
    ChannelTranslator[CTRLR_DEFAULT_VANG_CHN].Curve.Type = CTRLR_CURVE_TYPE_NONE;
    ChannelTranslator[CTRLR_DEFAULT_VANG_CHN].ActionFunc = Ctrlr_VangSet;

    ChannelTranslator[CTRLR_DEFAULT_SERVO0_CHN].Type = CRTLR_TYPE_SERVO;
    ChannelTranslator[CTRLR_DEFAULT_SERVO0_CHN].Instance.Servos = CTRLR_SERVOS_0;
    ChannelTranslator[CTRLR_DEFAULT_SERVO0_CHN].Curve.Type = CTRLR_CURVE_TYPE_NONE;
    ChannelTranslator[CTRLR_DEFAULT_SERVO0_CHN].ActionFunc = Ctrlr_ServoSetSpan;

    ChannelTranslator[CTRLR_DEFAULT_SERVO1_CHN].Type = CRTLR_TYPE_SERVO;
    ChannelTranslator[CTRLR_DEFAULT_SERVO1_CHN].Instance.Servos = CTRLR_SERVOS_1;
    ChannelTranslator[CTRLR_DEFAULT_SERVO1_CHN].Curve.Type = CTRLR_CURVE_TYPE_NONE;
    ChannelTranslator[CTRLR_DEFAULT_SERVO1_CHN].ActionFunc = Ctrlr_ServoSetSpan;

    ChannelTranslator[CTRLR_DEFAULT_SERVO2_CHN].Type = CRTLR_TYPE_SERVO;
    ChannelTranslator[CTRLR_DEFAULT_SERVO2_CHN].Instance.Servos = CTRLR_SERVOS_2;
    ChannelTranslator[CTRLR_DEFAULT_SERVO2_CHN].Curve.Type = CTRLR_CURVE_TYPE_NONE;
    ChannelTranslator[CTRLR_DEFAULT_SERVO2_CHN].ActionFunc = Ctrlr_ServoSetSpan;
}

/**
 * @brief  Initializes the Servo channels.
 *
 * @return DEF_TRUE if successful, DEF_FALSE otherwise.
 *
 * @note List of notes:
 *      1. Ensure that the target does not have more servos than the ones allowed by the
 *         controller.
 */
bool_t Ctrlr_Init(void) {
    bool_t ok;

    Ctrlr_InitTranslator();

    /* --- Servos --- */
    PLT_BUILD_ASSERT(CTRLR_NUM_SERVOS <= CTRLR_SERVOS_MAX); /* See note 1 */
    for (CTRLR_SERVOS_T m = 0; m < CTRLR_NUM_SERVOS; m++) {
        ok = Servo_Init((SERVO_HANDLER_T)&Target_Servos[m]);
        if (DEF_FALSE == ok) {
            return DEF_FALSE;
        }
    }

    return ok;
}

