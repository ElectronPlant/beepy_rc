#define CTRLR_DEFAULT_CHANNEL      {.Type = CRTLR_DISABLED}
#define CTRLR_DEFAULT_THROTTLE_CHN (0U)
#define CTRLR_DEFAULT_VANG_CHN     (1U)
#define CTRLR_DEFAULT_SERVO0_CHN   (2U)
#define CTRLR_DEFAULT_SERVO1_CHN   (3U)
#define CTRLR_DEFAULT_SERVO2_CHN   (4U)

static CTRLR_CHN_CFG_T ChannelTranslator[STD_FRAME_NUM_CHANNELS] = {0};
static uint16_t        ControllerThrottleChn = 0;
static uint16_t        ControllerVangChn = 0;

