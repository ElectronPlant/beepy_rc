/********************************************************************************
 * Defines
 ********************************************************************************/
#define SBUS_HEADER_VALUE     (0x0F)
#define SBUS_FOOTER_VALUE     (0x00)
#define SBUS_BODY_START_INDEX (1U) /* Raw byte index of the frame (excluding header)*/
#define SBUS_HEADER_SIZE      (1U)
#define SBUS_BODY_SIZE        (SBUS_FRAME_SIZE_BYTES - 1U) /* Frame size (excluding header) */

/********************************************************************************
 * Typedefs
 ********************************************************************************/
typedef enum {
    SBUS_RX_STATE_IDLE = 0,
    SBUS_RX_STATE_WAITING_FOR_RX,
    SBUS_RX_STATE_DONE,
    SBUS_RX_STATE_ERROR,
} SBUS_RX_STATE_T;

typedef struct {
    uint8_t                  RxBuffer[2 * SBUS_FRAME_SIZE_BYTES];
    volatile SBUS_RX_STATE_T State;
} SBUS_HANDLER_T;

/********************************************************************************
 * Function Prototypes
 ********************************************************************************/
static void Sbus_ResetHandler(void);
static void Sbus_HandleRx(void);

/********************************************************************************
 * Local Vars
 ********************************************************************************/
static SBUS_HANDLER_T Sbus_Handler;


/********************************************************************************
 * Function Implementations
 ********************************************************************************/

/**
 * @brief Reset the SBUS handler.
 *
 */
static void Sbus_ResetHandler(void) {
    Sbus_Handler.State = SBUS_RX_STATE_IDLE;
}

/**
 * @brief  Initializes the SBUS module.
 *
 * @return DEF_TRUE if successful, DEF_FALSE otherwise.
 *
 * @note List of notes:
 *       1. Any compilation error pointing to this line means that the SBUS buffer size is not
 *          correct.
 *       2. The SBUS protocol is and interted UART. This module assumes that the bus inversion is
 *          done at the hardware level. For the moment the UART peripheral is hardcoded.
 */
bool_t Sbus_Init(void) {
    PLT_BUILD_ASSERT(sizeof(SBUS_FRAME_STRUCT_T) == SBUS_FRAME_SIZE_BYTES);

    Sbus_ResetHandler();

    return Serial_Init(Sbus_HandleRx); /* See note 2 */
}

/**
 * @brief  Starts the SBUS reception.
 *         If there is a pending reception it also aborts the pending one.
 *
 * @return DEF_TRUE if successful, DEF_FALSE otherwise.
 */
bool_t Sbus_StartRx(void) {
    bool_t ok = DEF_TRUE;

    if (SBUS_RX_STATE_IDLE != Sbus_Handler.State && SBUS_RX_STATE_DONE != Sbus_Handler.State) {
        ok = Serial_AbortReceiveInt();
    }
    if (DEF_TRUE == ok) {
        Sbus_ResetHandler();
        Sbus_Handler.State = SBUS_RX_STATE_WAITING_FOR_RX;
        ok = Serial_ReceiveInt(Sbus_Handler.RxBuffer, 2 * SBUS_FRAME_SIZE_BYTES);
    }
    return ok;
}

/**
 * @brief
 *
 * @param  inp
 *
 * @return DEF_TRUE if successful, DEF_FALSE otherwise.
 *
 * @note List of notes:
 *       1.
 */
static bool_t Sbus_ProcessRxBuffer(SBUS_FRAME_T **p_frame) {
    bool_t found = DEF_FALSE;
    for (uint8_t b = 0; b < SBUS_FRAME_SIZE_BYTES && DEF_FALSE == found; b++) {
        /* Locate other potential headers */
        if ((SBUS_HEADER_VALUE == Sbus_Handler.RxBuffer[b] && b == 0
             && Sbus_Handler.RxBuffer[b + SBUS_FRAME_SIZE_BYTES - 1] == SBUS_FOOTER_VALUE)
            || (SBUS_HEADER_VALUE == Sbus_Handler.RxBuffer[b]
                && SBUS_FOOTER_VALUE == Sbus_Handler.RxBuffer[b - 1]
                && Sbus_Handler.RxBuffer[b + SBUS_FRAME_SIZE_BYTES - 1] == SBUS_FOOTER_VALUE)) {
            found = DEF_TRUE;
            *p_frame = (SBUS_FRAME_T *)&Sbus_Handler.RxBuffer[b];
        }
    }
    return found;
}

/**
 * @brief  Performs the SBUS frame validation and updates the SBUS state.
 *
 * @param  p_frame: Pointer to the SBUS frame to check.
 * @param  p_state: Pointer to the SBUS state variable to update.
 *
 * @return DEF_TRUE if the frame is valid; DEF_FALSE otherwise.
 *
 * @note List of notes:
 *       1. Frame integrity is checked ensuring that the header and footer values are correct.
 *          Further checks may be done in the future, but this is good enough for now.
 */
static bool_t Sbus_IsFrameValid(SBUS_FRAME_T *p_frame) {
    bool_t is_valid = DEF_FALSE;

    /* Validate Frame integrity, see note 1 */
    if (SBUS_HEADER_VALUE == p_frame->Frame.Header && SBUS_FOOTER_VALUE == p_frame->Frame.Footer) {
        is_valid = DEF_TRUE;
    }
    return is_valid;
}

/**
 * @brief  Gets the current SBUS frame.
 *
 * @param  p_data pointer to the SBUS status struct to be updated.
 */
void Sbus_GetFrame(SBUS_STATUS_T *p_data) {
    // TODO following lines are just for testing.
    static SBUS_FRAME_T TempFrame;
    SBUS_FRAME_T       *p_temp = NULL;
    if (DEF_TRUE == Sbus_ProcessRxBuffer(&p_temp)) {
        memcpy(&TempFrame, p_temp, sizeof(SBUS_FRAME_T));
        p_data->FramePtr = &TempFrame;
    } else {
        Sbus_Handler.State = SBUS_RX_STATE_ERROR;
    }

    SBUS_STATE_T state = SBUS_STATE_OK;
    if (SBUS_RX_STATE_DONE != Sbus_Handler.State) { /* Rx check */
        state = SBUS_STATE_RX_PENDING;
    } else if (DEF_FALSE == Sbus_IsFrameValid(p_data->FramePtr)) { /* Frame integrity check */
        state = SBUS_STATE_INVALID_FRAME;
    } else if (DEF_TRUE == p_data->FramePtr->Frame.Flags.FailsafeEnabled) { /* Failsafe */
        state = SBUS_STATE_FAILSAFE;
    } else if (DEF_TRUE == p_data->FramePtr->Frame.Flags.FrameLost) { /* Frame lost */
        state = SBUS_STATE_FRAME_LOST;
    }
    p_data->State = state;
}

static uint16_t Sbus_GetChannel(SBUS_FRAME_T *p_frame, uint8_t chn) {
    uint16_t value = 0;
    switch (chn) {
        case 1:
            value = p_frame->Frame.ServoChn.Chn1;
            break;
        case 2:
            value = p_frame->Frame.ServoChn.Chn2;
            break;
        case 3:
            value = p_frame->Frame.ServoChn.Chn3;
            break;
        case 4:
            value = p_frame->Frame.ServoChn.Chn4;
            break;
        case 5:
            value = p_frame->Frame.ServoChn.Chn5;
            break;
        case 6:
            value = p_frame->Frame.ServoChn.Chn6;
            break;
        case 7:
            value = p_frame->Frame.ServoChn.Chn7;
            break;
        case 8:
            value = p_frame->Frame.ServoChn.Chn8;
            break;
        case 9:
            value = p_frame->Frame.ServoChn.Chn9;
            break;
        case 10:
            value = p_frame->Frame.ServoChn.Chn10;
            break;
        case 11:
            value = p_frame->Frame.ServoChn.Chn11;
            break;
        case 12:
            value = p_frame->Frame.ServoChn.Chn12;
            break;
        case 13:
            value = p_frame->Frame.ServoChn.Chn13;
            break;
        case 14:
            value = p_frame->Frame.ServoChn.Chn14;
            break;
        case 15:
            value = p_frame->Frame.ServoChn.Chn15;
            break;
        case 16:
            value = p_frame->Frame.ServoChn.Chn16;
            break;
        default:
            PLT_UNREACHABLE;
    }
    return value;
}

void Sbus_DebugFrame(SBUS_FRAME_T *p_frame) {
    printf("------SBUS------\n");
    printf("Header: %u\n", p_frame->Frame.Header);
    printf("Servo Channels:\n");
    for (uint8_t c = 1; c <= SBUS_NUM_SERVO_CHANNELS; c++) {
        printf("    Chn %u: %d\n", c, Sbus_GetChannel(p_frame, c));
    }
    printf("Switch Channels:\n");
    printf("    Chn 16: %u\n", p_frame->Frame.Flags.Chn17);
    printf("    Chn 17: %u\n", p_frame->Frame.Flags.Chn18);
    printf(
        "Flags: Frame Lost (%u), Fail Safe (%u), Unused (%u)\n",
        p_frame->Frame.Flags.FrameLost,
        p_frame->Frame.Flags.FailsafeEnabled,
        p_frame->Frame.Flags.Unused
    );
    printf("Footer: %u\n", p_frame->Frame.Footer);
    printf("-----------------\n");
}


