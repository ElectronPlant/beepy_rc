		(uuid "8f3881b1-8301-434e-9c4e-4086274de1cb")
	)
	(text "--- Output capacitance ---\n\n	C_OUT = 44μF (22μF, 100μF) [typ., (min, max)]\n	I_CAP = (Vo * (Vin - Vo)) / (sqrt(12) * Vin * L * fsw) = 0.39A\n		L -> Inductor value\n		fsw -> Switching frequency (1200kHz)\n\n--- Inductance ---\n\n    L (Vo = 5V) = 1.8 (1.5, 4.7) μH [typ., (min, max)]\n    Inductance Ratings:\n	   Ip-p = (Vo / Vin_max) * (Vin_max - Vo) / (L * fsw) = 1.35A\n	   Ipeak = Io + Ip-p / 2 = 5.35A\n	   IL0_RMS = sqrt(Io^2 + (1/12) Ip-p^2) = 4.3A\n\n--- Feedback Resistors ---\n\n    Vo = 0.6 * (1 + R_FB1 / R_FB2)\n    R_FB2 = (0.6 + 0.6 R_FB1) / Vo"
		(exclude_from_sim no)
		(at 17.78 153.416 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "9307061d-4011-4985-881c-14196fd47a2a")
	)
	(text "BeepyRC"
		(exclude_from_sim no)
		(at 232.664 173.99 0)
		(effects
			(font
				(size 7.62 7.62)
			)
		)
		(uuid "a3f0302e-c70b-4030-a629-03cace2395db")
	)
	(text "--- EN input ---\n\nWhen:\n  - EN is > 1.18(1.07, 1.33)V the module is enabled.\n  - EN is < 1(0.95, 1.2)V the module is disabled.\n\nFixing R_EN1 + R_EN2 -> R_EN2 =  (R_EN1 + R_EN2) * V_EN / V_IN\nV_CUT = V_EN * (R_EN1 + R_EN2) / R_EN2\n\nTo limit to 6V input with R_EN1 + R_EN2 = 50k:\n   R_EN2 ~8.2k\n   R_EN1 ~40k\n   V_CUT = 5.87V (5.58, 7.05)\n\nThis is too unreliable so it will be driven by the MCU!!"
		(exclude_from_sim no)
		(at 160.274 143.51 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "a62e3826-4e0c-49b5-8b86-b36bd1d6dbc9")
	)
