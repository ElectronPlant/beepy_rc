	(text "V_BAT_MEAS = 0.24 * V_BAT"
		(exclude_from_sim no)
		(at 239.268 92.71 0)
		(effects
			(font
				(size 1.778 1.778)
			)
		)
		(uuid "17e2431a-8aec-4208-9413-f98641fa652e")
	)
	(text "--- INA139 ---\n\nOutput Voltage: Vo = Is * 1mA/V * R_L\nVs full scale = 100mV (could also be 50mV to 500mV)\nR_L -> Set to generate ~3V at 6A (<50kOhm, ADC external resistance limit)\nC_L -> Low pass filter with a cut-off frequency at ~1kHz\n    "
		(exclude_from_sim no)
		(at 17.272 165.1 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left)
		)
		(uuid "300753ce-dd3a-4635-9467-1df050cbaa54")
	)
	(text "--- Battery Voltage ---\n\n2S battery range 6 - 8.4V, with 7.4 nominal\nMaximum ranges 6 - 12V --> Limited by the N20 motors\nR_SENSE is set to:\n	1. Be <50kOhm (ADC external resistance limit),\n	2. V_BAT_MEAS is ~3V @ 12V\n	3. Low-pass filter with Fc ~1kHz"
		(exclude_from_sim no)
		(at 18.288 138.43 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "747f7a99-f4a6-473c-ba02-e7c57f524ff3")
	)
	(text "Is = 0.51A/V * V_I_SENSE (fc = 1.04kHz)"
		(exclude_from_sim no)
		(at 244.602 45.466 0)
		(effects
			(font
				(size 1.778 1.778)
			)
		)
		(uuid "ae421abf-21e9-4653-9c3c-e43a36d0b73f")
	)
	(text "--- Shunt Resistor ---\n\nVs = 100mV with max current\nmax(Is) = 6A > (4 * 0.35A for the motors + 4A for the 5.5V rail)\nRs = Vs / max(Is) = ~17mOhm\nPower Rating: 0.6W"
		(exclude_from_sim no)
		(at 17.272 184.404 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "b39825ad-1065-4a8a-95a0-0b325363b5d2")
	)
	(text "0.1%"
		(exclude_from_sim no)
		(at 87.63 88.9 0)
